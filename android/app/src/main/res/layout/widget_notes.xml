<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Forgeboard Notes"
            android:textColor="#F1F5F9"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_add"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_button"
            android:contentDescription="Add a note"
            android:gravity="center"
            android:text="+"
            android:textColor="#BAE6FD"
            android:textSize="28sp" />
        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_button"
            android:contentDescription="Sync notes now"
            android:gravity="center"
            android:text="↻"
            android:textColor="#BAE6FD"
            android:textSize="26sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_scope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingBottom="5dp"
        android:text="Project notebook"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/widget_accent"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginBottom="6dp"
        android:background="#7DD3FC"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="4"
        android:ellipsize="end"
        android:text="Tap + to write your first note."
        android:textColor="#CBD5E1"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Open app to connect"
            android:textColor="#94A3B8"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_more"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="48dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Open"
            android:textColor="#BAE6FD"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Choose widget project or note"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#CBD5E1"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
